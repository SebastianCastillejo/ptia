# true  -> usa el motor simulado del navegador (no necesita backend)
# false -> llama al backend real por /api
VITE_USE_MOCK=true

# A dónde redirige el proxy de Vite las llamadas /api en desarrollo
VITE_BACKEND_URL=http://localhost:8000

# Solo si el front se publica separado del back (producción). En local déjalo vacío.
VITE_API_BASE_URL=
